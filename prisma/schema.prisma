generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Usuario {
  id       String   @id @default(cuid())
  nombre   String
  email    String   @unique
  password String
  creadoEn DateTime @default(now())
}

model Producto {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  precio      Float
  stock       Int
  categoria   String?
  creadoEn    DateTime @default(now())
}
