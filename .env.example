# Copia este archivo como .env antes de correr el proyecto:
#   cp .env.example .env
DATABASE_URL="file:./dev.db"

# Better Auth. La URL base de la aplicacion y la clave con la que se firman las
# sesiones. Genera la tuya con:
#   openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="cambia-esta-clave"
